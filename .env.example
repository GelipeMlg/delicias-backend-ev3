# Copiar como .env para desarrollo. Ninguna clave real se distribuye.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Activar solo detrás de un proxy controlado que reescriba X-Forwarded-Proto.
DJANGO_TRUST_PROXY=0
DJANGO_HSTS_SECONDS=0
# Vacío: SQLite local. En producción configurar PostgreSQL persistente.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
# Cache de límites compartida en la base de datos.
DJANGO_CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
DJANGO_CACHE_LOCATION=api_rate_cache
API_ANON_RATE=120/hour
API_USER_RATE=1200/hour
API_LOGIN_RATE=10/minute
API_REGISTER_RATE=5/hour
API_REFRESH_RATE=30/minute
